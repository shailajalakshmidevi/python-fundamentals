\
## Multiple Variable Creation: it helps to create multiple variables in the single line\
## syntax:  var1, var2,..... = val1, val2,.....\
## note: the number of varibales should be equal to number of values\
\
a, b, c = 100, 200, 300\
print(a, b, c)\
\
# a, b, c = 1,2\
\
# a, b, c = 1,2,3,4\
\
\
## Rules for creating the variabels\
\
\
##1. The keywords should not be used as variable\
\
a = True\
print(a)\
\
# True = 1\
\
##2. variables should not start with numbers\
\
a2 = 40\
print(a2)\
\
\
a2b = 300\
print(a2b)\
\
# 2a = 89\
# print(2a)\
\
\
##3. The variables should not begin with or have the space in between\
\
#  a=90\
# print( a)\
\
\
# a b = 90\
# print(a b)\
\
\
ab = 78\
print(ab)\
\
\
##4. the variables should not contain any specail char except underscore\
\
# a@ = 90\
\
# $b = 78\
\
\
# a@b = 90\
\
a_ = 90\
print(a_)\
\
\
a_b = 90\
print(a_b)\
\
_a = 90\
print(_a)\
\
_ = 900\
print(_)\
\
\
##5. The variables can be alphabet(uppercase, lowercase, both) or alphanumeric\
\
aa = 900\
print(aa)\
\
\
AA = 900\
print(AA)\
\
aB = 900\
print(aB)\
\
a2 = 9000\
print(a2)\
\
##6. According to ISR the length of the variable restricted to 32, even if it exceeds control will not throw any error\
\
hgfdertyuioiuytrdfgERTYUIOIUFDXCVBNHGFDertyu3456789876543tYUJHGFDRTYUJHGFCVBJHRY3456788trdfghbvcdtyu = 435456\
print(hgfdertyuioiuytrdfgERTYUIOIUFDXCVBNHGFDertyu3456789876543tYUJHGFDRTYUJHGFCVBJHRY3456788trdfghbvcdtyu)\
\
\
## Datatypes: it helps determine what type of value stored in the variable\
\
## it is classified into 2 types based on the size of the data\
\
\
## Single value Datatypes : it stores single value wrt to one variable\
\
## there are types in SVD\
\
##1. Numeric\
\
## there are 3 types in Numeric Datatypes\
\
## Integer:\
    ##1. The real numbers without decimals\
    ##2. we can +ve or -ve number\
    ##3. The default value is 0\
\
\
var = 100\
print(type(var))\
print(type(100))\
\
a = -90\
print(type(a))\
print(type(0))\
\
##2. Float:\
    ##1. The real numbers with decimals\
    ##2. +ve or -ve\
    ##3. the default value is 0.0\
    \
a = 9.8\
print(type(a))\
\
a = -9.8\
print(type(a))\
print(type(0.0))\
\
##3. Complex :\
    ##1. the complex nmnber is represented as a + bj or a - bj\
    ##2. a is real part b is imaginary part\
    ##3. the value for a and b can either be int or Float\
    ##4. The default value is 0j\
    \
c = 5 + 9j\
print(type(c))\
\
c = 5.8 + 9j\
print(type(c))\
\
c = 5.6 + 9.5j\
print(type(c))\
\
c = -5 - 9j\
print(type(c))\
\
print(c)\
\
# c = -5 - 9i\
# print(type(c))\
\
c = -5 - 9J\
print(type(c))\
print(c)\
\
print(type(0j))\
\
##2. Boolean: True and False\
\
## these values are used in 2 cases\
\
##1. we can use it as value to any variable\
\
a = True\
b = False\
print(type(a), type(b))\
\
##2. it is used as resultant to check the condition\
\
print(1 > 6)\
print(100 < 400)\
\
print(bool(0))          ## Always the default values are internally boolean False and non-default value is internally boolean True\
print(bool(3))\
\
print(bool(0.0))\
print(bool(8.0))\
\
print(bool(0j))\
\
\
\
\
## Multi value Datatypes(collection type): it stores multiple values wrt to one variable\
\
## there are 5types\
\
##1. String Datatypes\
##2. List Datatypes\
##3. Tuple Datatypes\
##4. Set Datatypes\
##5. Dictionay Datatypes\
\
\
## String Datatypes: it is the collection of character(alphabets, numbers or special character) enclosed between pair os single or double or triple quotes\
\
## syntax;\
\
var = 'val1val2,.....'\
\
# or\
\
var = "val1val2,...."\
\
##or\
\
var = '''val1val2,,,'''\
\
\
string = 'hello123$%^'\
print(type(string))\
print(string)\
\
\
string = "hello123$%^"\
print(string)\
\
string = '''hello123$%^'''\
print(string)\
\
\
# string = 'this is world's best place'\
\
\
string = 'this is world\\'s best place'         ## this is not pythonic way\
print(string)\
\
\
string = "this is world's best place"\
print(string)\
\
# sentence = 'hello good evening\
# how are you'\
\
# sentence = "hello good evening\
# how are you"\
\
sentence = '''hello good evening\
how are you'''\
print(sentence)\
\
\
string = 'hello'\
print(len(string))                ## len(): it helps to get the number of characters present in the string\
print(len('hello'))\
string1 = 'jhgre876545678REDFGHJR$%^&*(&^%$#WSDFTGHBVC Byt543456789876543ertyhgbvbnvcfdrtyuiy#$%^&YTRFDVB'\
print(len(string1))\
\
\
## to customize the string\
\
name = 'Sonu'\
age = 23\
\
## Hello myself Sonu of age 23 years\
\
\
print('Hello myself Sonu of age 22 years')\
\
##1. f-string\
\
print(f'Hello myself \{name\} of age \{age\} years')\
\
age = 25\
\
print(f'Hello myself \{name\} of age \{age\} years')\
\
\
# print(f'Hello myself \{name\} of age \{age\} years from \{place\}')\
\
## format attribute\
\
print('Hello myself \{\} of age \{\} years'.format(name, age))\
print('Hello myself \{\} of age \{\} years'.format(age, name))\
\
\
string = 'python'\
print(string)\
\
## variable[index]\
\
print(string[1])\
\
print(string[4])\
\
print(string[-1])\
\
