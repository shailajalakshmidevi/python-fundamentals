\outl0\strokewidth0 \strokec2 What is python?\
# 	It is high level and general purpose programming language.\
\
\
# Features of python\
\
# 	1. It is easy to learn and code\
# 	2. It is high level language\
# 	3. It is free and open source\
# 	4. It is platform independent\
# 	5. It is dynamically typed language                  \
# 	6. It is interpreted language\
# 	7. The number of lines of code are less,  so efficiency increases\
# 	8. It is having large library functions\
\
\
# Library Functions: These are the functions which are already pre-defined by developers, which we can use in out code but we can't modify the functionalities.\
\
# 	There are 3 types\
# 	1. Keywords\
# 	2. Inbuilt functions\
# 	3. Operators\
\
\
# 	1. Keywords: these are reserved words  which are already pre-defined by developers, which we can use in out code but we can't modify the functionalities.\
  \
# Or\
\
# These are universal standard words\
	\
# Syntax:\
\
# Import keyword\
# Keyword.kwlist\
\
\
import keyword\
print(keyword.kwlist)\
\
## True, False and None are the unique keywords\
\
a = True\
print(a)\
\
b = False\
print(b)\
\
# c = break\
# print(c)\
\
## we can't use any keyword as value to variable except True, False, None\
\
# True = 90\
# print(True)\
\
# break = 56\
\
## we can't use keywords as variable itself \
\
\
## variables: it is the name given to memory location where the value is stored\
## syntax:   var_name = value,  ex: a = 10\
\
# a = 200\
# print(id(a))\
\
# a = 10\
# print(a)\
\
# b = 200\
# print(b)\
\
# a = 30\
# print(a)\
\
\
a = 100\
print(id(a))\
\
b = 200\
print(id(b))\
\
c = 100\
print(id(c))\
\
## when two differnt variables have the same value then address of both the variable will be the same\
\
b = 500\
print(id(b))\
\
\
## when same variable asigned to the differnt values the previous address get deleted and latest willbe stored\
\
\
a = 500\
print(id(a))\
\
\
\
\
\
\
\
